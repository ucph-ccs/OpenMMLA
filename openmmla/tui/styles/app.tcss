/* main app styles */

Screen {
    background: $surface;
}

#tab-bar {
    dock: top;
    height: 3;
    padding: 0 1;
    background: $panel;
}

#tab-bar Button {
    margin: 0 1;
    min-width: 18;
}

#tab-bar Button.active-tab {
    background: $accent;
    color: $text;
    text-style: bold;
}

FieldRow {
    layout: vertical;
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
}

FieldRow .field-label {
    text-style: bold;
    padding: 0;
}

FieldRow .field-desc {
    color: $text-muted;
    padding: 0;
    margin-bottom: 0;
    width: 100%;
    overflow: hidden;
}

FieldRow .field-input {
    width: 100%;
}

FieldRow .field-textarea {
    width: 100%;
    height: 6;
}

ConfigForm {
    height: auto;
    padding: 1 2;
}

ConfigForm Collapsible {
    margin-bottom: 1;
}

DictListField {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

.dict-entry {
    height: auto;
    border: dashed $primary;
    padding: 1;
    margin-bottom: 1;
}

.dict-entry-header {
    text-style: bold;
    color: $text-muted;
    margin-bottom: 0;
}

.dict-entry-row {
    height: auto;
    margin-bottom: 0;
}

.dict-entry-label {
    width: 12;
    padding-top: 1;
}

.dict-entry-input {
    width: 1fr;
}

.dle-rm-btn {
    margin-top: 1;
}

.dle-add-btn {
    margin-top: 1;
}

ConfigForm .form-actions {
    height: auto;
    padding: 1 0;
    margin-top: 1;
}

ConfigForm .form-actions Button {
    margin: 0 1;
    min-width: 20;
}

#btn-add-base {
    margin: 1 2;
}

.add-base-bar {
    layout: horizontal;
    height: auto;
    padding: 1 2;
}

.add-base-bar Input {
    width: 1fr;
}

.add-base-bar Button {
    margin: 0 1;
    min-width: 10;
}

.status-saved {
    color: $success;
    text-style: bold;
    padding: 0 2;
    margin-top: 1;
}

.status-info {
    color: $accent;
    padding: 0 1;
    text-style: bold;
    margin-bottom: 1;
}

/* service panel */

.service-card {
    height: auto;
    border: solid $primary;
    padding: 1;
    margin: 0;
}

.service-card .card-title {
    text-style: bold;
    color: $text;
}

.service-card .card-status-running {
    color: $success;
}

.service-card .card-status-stopped {
    color: $error;
}

.service-card .card-config-ok {
    color: $success;
}

.service-card .card-config-missing {
    color: $warning;
}

/* status screen */

#status-summary {
    dock: top;
    height: 3;
    padding: 0 2;
    background: $panel;
    content-align: center middle;
}

#log-panel {
    height: 12;
    border-top: solid $primary;
    padding: 1;
    background: $panel;
}
