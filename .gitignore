# Ignore directories
venv/
.idea/
.cursor/
.codex/
.vscode/
*.egg-info/
.*/
dist/
build/
temp/
logger/
analysis/
openmmla/analytics/framework/
omini/

# Ignore deprecated repositories
deprecated/
version_control/

# Ignore directories at any level
**/tests/
!tests/
tests/*
!tests/test_environment_screen.py
!tests/test_launcher_services.py
!tests/test_asr_server_extras.py
!tests/test_vfa_optional_imports.py
!tests/test_vfa_vllm_command.py
!tests/test_vfa_vllm_runtime_extra.py
**/__pycache__/
**/data/
**/logs/
**/real-time/
**/visualizations/
**/camera_sync/
**/fine_tune/

# Ignore generated files
*.generated.conf
**/.next/

# Ignore specific files
.DS_Store
twine.txt

# Ignore specific files at any level
**/config.yml

# Unignore specific files
!.gitkeep
CLAUDE.md
AGENTS.md
