# Ignore directories
venv/
.idea/
.cursor/
.codex/
.vscode/
*.egg-info/
.*/
dist/
build/
temp/
logger/
analysis/
openmmla/analytics/framework/
omini/
group_state/

# Ignore deprecated repositories
deprecated/
version_control/

# Ignore directories at any level
**/tests/
tests/*
**/__pycache__/
**/data/
**/logs/
**/real-time/
**/post-time/
**/visualizations/
**/camera_sync/
**/fine_tune/
/artifacts/
/collection/

# Ignore generated files
*.generated.conf
*.pt
*.pth
*.onnx
**/.manifest.lock
**/.next/

# Ignore specific files
.DS_Store
twine.txt
docs/paper.md

# Ignore specific files at any level
**/config.yml

# Unignore specific files
!.gitkeep
CLAUDE.md
AGENTS.md
