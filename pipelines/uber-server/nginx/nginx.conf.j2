worker_processes auto;

events {
    worker_connections 2048;
    multi_accept on;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;
    client_max_body_size 50M;

    {# every server whose name resolves (render_nginx.py), running or not: nginx itself
       skips one that fails for fail_timeout and then tries it again, so a server
       that starts later is used without a new render, and the config does not
       depend on what was up when it was rendered. The zone shares what the
       workers learn of them (256k: 64k is too small where pages are 16 KB) #}
    {% for name, servers in config.upstreams.items() if servers | selectattr('routed') | list | length > 0 %}
    upstream {{ name }} {
        zone {{ name }} 256k;
        {% for s in servers if s.routed %}
        server {{ s.ip }}:{{ s.port }} weight={{ s.weight }} max_fails=1 fail_timeout=30s;
        {% endfor %}
        keepalive 40;
    }
    {% endfor %}

    server {
        listen 8080;
        server_name localhost;

        location / {
            root html;
            index index.html index.htm;
        }

        {# no error_page for 5xx: Ubuntu's nginx ships no 50x.html, and a missing page turned
           a server that does not answer (502) into a 404, which the bases do not retry #}

        {# a location for every upstream rendered above #}
        {% for name, servers in config.upstreams.items() if servers | selectattr('routed') | list | length > 0 %}
        location /{{ name }} {
            proxy_pass http://{{ name }};
            proxy_next_upstream error timeout http_500 http_502 http_503 http_504;
            proxy_next_upstream_tries 3;
            {# a machine that is off holds a request this long, once per fail_timeout, before
               proxy_next_upstream sends it on; a base waits 10 s for its answer #}
            proxy_connect_timeout 2s;
            proxy_send_timeout 350s;
            proxy_read_timeout 350s;
        }
        {% endfor %}

        {# a service not one of whose names resolves has no upstream to send to, and gets
           a route all the same: 503 says "no server answers" and the bases retry it,
           where a missing route (404) reads as a missing service and is not retried #}
        {% for name, servers in config.upstreams.items() if servers | selectattr('routed') | list | length == 0 %}
        location /{{ name }} {
            return 503;
        }
        {% endfor %}
    }
}
