# environment for docker/docker-compose.infra.yml (InfluxDB + MongoDB).
#
# copy this file to docker/.env on the machine that holds the databases and fill it in.
# docker/.env is gitignored because it carries real secrets; this template is the tracked
# stand-in, the same pattern as config/ssh_profiles_template.yml.
#
#   cp docker/.env.example docker/.env
#   chmod 600 docker/.env
#
# every value below is read ONLY on the first start against an empty volume. changing one
# afterwards does nothing — see docs/docker.md -> Known caveats.

# ── InfluxDB ─────────────────────────────────────────────────────
# generate with: openssl rand -hex 32
# this is also the value that goes into TUI -> System Settings -> InfluxDB -> token
INFLUXDB_INIT_ADMIN_TOKEN=

# web UI login at http://<host>:8086 — 8 chars minimum, but the UI is published on the
# LAN, so generate a real one: openssl rand -base64 24
INFLUXDB_INIT_PASSWORD=

# these three must match config/system_services.yml; the defaults already do
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_ORG=admin
INFLUXDB_INIT_BUCKET=mmla-data

# ── MongoDB ──────────────────────────────────────────────────────
# leave BOTH empty to keep the credential-free behaviour of the bare-metal setup.
# set BOTH to enable --auth on a fresh volume; the URL then becomes
#   mongodb://<user>:<pass>@<host>:27017/?authSource=admin
# setting only one makes the container restart-loop.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# ── networking ───────────────────────────────────────────────────
# 0.0.0.0 publishes on every interface. on a host with a VPN or public NIC, set this to
# the LAN address so the databases are only reachable there.
INFRA_BIND_ADDRESS=0.0.0.0

# a second address the same ports are published on, for processes on THIS machine.
# needed once INFRA_BIND_ADDRESS names one interface the host cannot dial itself: a
# tailnet or VPN address, say, while the host's own name resolves to 127.0.1.1 and
# nothing listens there — the dashboard then gets ECONNREFUSED from its own machine.
# set it to 127.0.0.1 in that case, and use http://localhost:<port> in this machine's
# own config. LEAVE IT EMPTY while INFRA_BIND_ADDRESS is 0.0.0.0: a wildcard bind plus
# a 127.0.0.1 bind on one port is refused by the kernel and the container will not start.
INFRA_LOOPBACK_ADDRESS=

# host ports the containers are published on. change these when another project
# already holds 8086 / 27017 on this machine (docker refuses a 0.0.0.0 bind on a
# port that is taken on 127.0.0.1). the TUI reads the port back from the url you
# save in System Settings, so keep the two in step:
#   INFLUXDB_PORT=8087  ->  InfluxDB.url  http://<host>:8087
#   MONGODB_PORT=27018  ->  MongoDB.url   mongodb://<host>:27018
INFLUXDB_PORT=8086
MONGODB_PORT=27017

# MediaMTX stream server (docker-compose.infra.yml): host ports and where the
# server-side recordings land (relative to the docker/ directory, or absolute)
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_SRT_PORT=8890
MEDIAMTX_API_PORT=9997
MEDIAMTX_PLAYBACK_PORT=9996
MEDIAMTX_STREAMS_DIR=../artifacts/streams/server
